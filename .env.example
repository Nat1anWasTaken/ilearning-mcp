# Externally visible origin; OAuth metadata and the MCP resource URL derive from it.
PUBLIC_URL=http://localhost:8080
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://ilearning_mcp:ilearning_mcp@localhost:5443/ilearning_mcp

# 32 random bytes, base64. Encrypts iLearning tokens at rest and signs file
# download links: `openssl rand -base64 32`
ENCRYPTION_KEY=

# The i-learning (Moodle) site.
ILEARNING_URL=https://ilearning.cycu.edu.tw
# Comma-separated Moodle usernames (student IDs) allowed to sign in. Empty allows anyone.
ALLOWED_MOODLE_USERNAMES=
# Assumed lifetime of a newly issued iLearning token, in days (Moodle default: 84).
TOKEN_DURATION_DAYS=84

# Built dashboard directory.
# WEB_DIST=web/dist
# RUST_LOG=info,ilearning_mcp=debug,moodle=debug

# Production only (docker-compose.yml): password for the bundled Postgres.
# DATABASE_URL is derived from it there.
POSTGRES_PASSWORD=
